<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CM.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/level"
                style="@style/TextAppearance.CM.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="URGENTE"
                android:textColor="@color/danger"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/days"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="vence em 2 dias"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/product"
            style="@style/TextAppearance.CM.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Produto" />

        <TextView
            android:id="@+id/details"
            style="@style/TextAppearance.CM.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stock"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 un disponíveis"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showcase"
                style="@style/Widget.CM.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:text="Vitrine"
                android:textSize="9sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/movement"
                style="@style/Widget.CM.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:text="Dar baixa"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
