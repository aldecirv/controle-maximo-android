<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/text_primary" />
        <TextView style="@style/TextAppearance.CM.H2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:text="Segurança" android:textSize="17sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="5dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_gradient_hero" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIVACIDADE E INTEGRIDADE" android:textColor="#B9D6F5" />
                    <TextView style="@style/TextAppearance.CM.H1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Dados no seu aparelho" android:textColor="@color/white" android:textSize="22sp" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sem conta, sem nuvem, sem internet." android:textColor="#D6E7F8" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                    <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Banco local" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Produtos, lotes, movimentações e reservas ficam em um banco SQLite privado no aparelho. Nenhum dado é enviado para servidores." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                    <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Movimentações imutáveis" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Vendas, doações e descartes são append-only: não podem ser alterados nem excluídos. Correções devem ser registradas como ajuste auditável." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                    <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vitrine sem dados internos" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="A vitrine mostra apenas nome, categoria, validade, preço com desconto e saldo. Custo, fornecedor e margem nunca aparecem." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                    <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reservas com TTL de 2 horas" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Reservas ativas expiram automaticamente; a quantidade volta ao saldo livre do lote. Reservas não são vendas e não entram nos relatórios até a baixa." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp">
                    <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Permissões" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="O app não pede internet, localização, contatos, câmera ou armazenamento externo. O CSV é exportado pelo seletor do próprio Android." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
