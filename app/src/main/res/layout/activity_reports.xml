<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/text_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/TextAppearance.CM.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relatórios" android:textSize="16sp" />
            <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vendas, doações e perdas" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/export" style="@style/Widget.CM.Button.Outlined" android:layout_width="wrap_content" android:layout_height="38dp" android:minWidth="0dp" android:text="Exportar" android:textSize="9.5sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="5dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp">
                    <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERÍODO" android:textColor="@color/primary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Início">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/startInput" android:layout_width="match_parent" android:layout_height="46dp" android:clickable="true" android:focusable="false" android:inputType="none" android:paddingTop="8dp" android:paddingBottom="8dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Fim">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/endInput" android:layout_width="match_parent" android:layout_height="46dp" android:clickable="true" android:focusable="false" android:inputType="none" android:paddingTop="8dp" android:paddingBottom="8dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp">
                        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vendido" />
                        <TextView android:id="@+id/sold" style="@style/TextAppearance.CM.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/success" android:textSize="17sp" />
                        <TextView android:id="@+id/soldQty" style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 itens" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp">
                        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doado" />
                        <TextView android:id="@+id/donated" style="@style/TextAppearance.CM.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/primary" android:textSize="17sp" />
                        <TextView android:id="@+id/donatedQty" style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 itens" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp">
                        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Descartado" />
                        <TextView android:id="@+id/discarded" style="@style/TextAppearance.CM.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00" android:textColor="@color/danger" android:textSize="17sp" />
                        <TextView android:id="@+id/discardedQty" style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 itens" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="11dp">
                        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aproveitamento" />
                        <TextView android:id="@+id/utilization" style="@style/TextAppearance.CM.H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="@color/accent" android:textSize="17sp" />
                        <TextView android:id="@+id/recovered" style="@style/TextAppearance.CM.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$ 0,00 recuperados" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Por categoria" />
            <LinearLayout android:id="@+id/categoriesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />

            <TextView style="@style/TextAppearance.CM.H3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Formas de pagamento" />
            <LinearLayout android:id="@+id/paymentsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
