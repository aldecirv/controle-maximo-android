<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_box"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.CM.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controle Máximo"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/storeName"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Minha loja"
                android:textSize="9.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageButton
                android:id="@+id/bellButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Alertas"
                android:padding="10dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/urgentBadge"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_badge_red"
                android:gravity="center"
                android:minWidth="15dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="0"
                android:textColor="@color/danger"
                android:textSize="8sp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mais"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navDashboardIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_dashboard"
                app:tint="@color/primary" />
            <TextView
                android:id="@+id/navDashboardLabel"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Painel"
                android:textColor="@color/primary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navRegisterIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_add"
                app:tint="@color/text_tertiary" />
            <TextView
                android:id="@+id/navRegisterLabel"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cadastro"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navAlertsIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/text_tertiary" />
            <TextView
                android:id="@+id/navAlertsLabel"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Alertas"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navStockIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/text_tertiary" />
            <TextView
                android:id="@+id/navStockLabel"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Baixas"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navMoreIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_more"
                app:tint="@color/text_tertiary" />
            <TextView
                android:id="@+id/navMoreLabel"
                style="@style/TextAppearance.CM.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mais"
                android:textColor="@color/text_tertiary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
