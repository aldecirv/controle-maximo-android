<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/back" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/text_primary" />
        <TextView style="@style/TextAppearance.CM.H2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:text="Ajustes" android:textSize="17sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="5dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOJA" android:textColor="@color/primary" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Nome da loja">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/storeInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textCapSentences" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="PRAZOS DE ALERTA" android:textColor="@color/primary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Atenção (dias)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/attentionInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="number" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Urgente (dias)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/urgentInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="number" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Vitrine (dias)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/showcaseInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="number" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Desconto padrão (%)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/discountInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="numberDecimal" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Atenção deve ser maior que urgente. A vitrine mostra lotes dentro desse prazo, com saldo livre." android:textSize="9.5sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/saveButton" style="@style/Widget.CM.Button" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:text="Salvar ajustes" />

            <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="DADOS LOCAIS" android:textColor="@color/danger" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.CM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/resetDemo" style="@style/Widget.CM.Button.Outlined" android:layout_width="match_parent" android:layout_height="42dp" android:text="Restaurar dados de exemplo" android:textSize="10sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/wipeData" style="@style/Widget.CM.Button.Outlined" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="Apagar todos os dados" android:textColor="@color/danger" android:textSize="10sp" />
                    <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="As movimentações são imutáveis. Apagar todos os dados remove produtos, lotes, reservas e histórico — use com cuidado." android:textSize="9.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/TextAppearance.CM.BodyStrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Controle Máximo 1.0.0" />
            <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MVP offline de gestão de validade para pequenos comércios. Dados no próprio aparelho." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
