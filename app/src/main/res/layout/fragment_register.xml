<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENTRADA DE ESTOQUE" android:textColor="@color/primary" />
        <TextView style="@style/TextAppearance.CM.H1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Produto e lote" android:textSize="24sp" />
        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadastre um produto novo ou adicione um lote a um produto existente." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CM.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip android:id="@+id/modeNew" style="@style/Widget.CM.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Produto novo" />
                    <com.google.android.material.chip.Chip android:id="@+id/modeExisting" style="@style/Widget.CM.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Produto existente" />
                </com.google.android.material.chip.ChipGroup>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/existingLayout"
                    style="@style/Widget.CM.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Selecione o produto"
                    android:visibility="gone">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/existingProduct"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:inputType="none"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/productFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DADOS DO PRODUTO" android:textColor="@color/primary" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Nome do produto">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textCapSentences" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Categoria">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/categoryInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textCapSentences" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="96dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:hint="Unidade">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/unitInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="text" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="un" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Custo (R$)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/costInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="numberDecimal" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Venda (R$)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/priceInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="numberDecimal" android:paddingTop="9dp" android:paddingBottom="9dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:hint="Fornecedor">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/supplierInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="textCapSentences" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView style="@style/TextAppearance.CM.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="DADOS DO LOTE" android:textColor="@color/primary" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Código do lote">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/lotCodeInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="text" android:paddingTop="9dp" android:paddingBottom="9dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Fabricação">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/manufactureInput" android:layout_width="match_parent" android:layout_height="50dp" android:clickable="true" android:focusable="false" android:inputType="none" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Validade">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/expiryInput" android:layout_width="match_parent" android:layout_height="50dp" android:clickable="true" android:focusable="false" android:inputType="none" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Quantidade inicial">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/quantityInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="numberDecimal" android:paddingTop="9dp" android:paddingBottom="9dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.CM.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:hint="Desconto (%)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/discountInput" android:layout_width="match_parent" android:layout_height="50dp" android:inputType="numberDecimal" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="30" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView style="@style/TextAppearance.CM.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="A validade deve ser posterior à fabricação. O lote entra no estoque disponível e gera alertas conforme os prazos configurados." android:textSize="9.5sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.CM.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Salvar produto e lote" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
