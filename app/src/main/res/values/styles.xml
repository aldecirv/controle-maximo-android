<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.CM.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">25sp</item>
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="TextAppearance.CM.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.CM.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.CM.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="TextAppearance.CM.BodyStrong" parent="TextAppearance.CM.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.CM.Caption" parent="TextAppearance.CM.Body">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
    <style name="TextAppearance.CM.Label" parent="TextAppearance.CM.Caption">
        <item name="android:textSize">9.5sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.CM.Mono" parent="TextAppearance.CM.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.CM.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="Widget.CM.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Widget.CM.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">42dp</item>
    </style>
    <style name="Widget.CM.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Widget.CM.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">13dp</item>
        <item name="boxCornerRadiusTopEnd">13dp</item>
        <item name="boxCornerRadiusBottomStart">13dp</item>
        <item name="boxCornerRadiusBottomEnd">13dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
    <style name="Widget.CM.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">10.5sp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">32dp</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
    </style>
</resources>
